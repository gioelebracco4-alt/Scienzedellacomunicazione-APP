# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API Keys / Data API).
# Solo chiavi PUBBLICHE: mai la service_role o altre chiavi segrete.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
